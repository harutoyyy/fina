// ============================================================
// 経理くん（fina） Prisma Schema
// Version: 1.0
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["fina"]
}

// ============================================================
// 0. Better Auth 管理テーブル
// ============================================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      AuthAccount[]
  profile       UserProfile?

  @@schema("fina")
  @@map("user_fina")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("session_fina")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("account_fina")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("fina")
  @@map("verification_fina")
}

// ============================================================
// 1. ユーザープロファイル（Better Auth拡張）
// ============================================================

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER

  @@schema("fina")
}

model UserProfile {
  id              String    @id @default(cuid())
  authUserId      String    @unique
  role            UserRole  @default(OPERATOR)
  displayName     String
  assignedCompanyIds String[]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("user_profiles_fina")
}

// ============================================================
// 2. 会社マスタ
// ============================================================

model Company {
  id              String    @id @default(cuid())
  name            String    // 会社名
  nameKana        String?   // 会社名フリガナ
  shortName       String?   // 略称（帳票表示名）
  industryType    String?   // 業種
  representativeTitle String? // 代表者役職
  representativeName  String? // 代表者氏名
  postalCode      String?   // 郵便番号
  addressPrefecture   String? // 都道府県
  addressCity     String?   // 市区町村
  addressStreet   String?   // 番地
  addressBuilding String?   // 建物名
  phone           String?   // 電話番号
  fax             String?   // FAX番号
  email           String?   // 代表メールアドレス
  website         String?   // WebサイトURL
  corporateNumber String?   // 法人番号（13桁）
  invoiceNumber   String?   // インボイス登録番号
  fiscalMonth     Int       @default(3) // 決算月（1〜12）
  establishedDate DateTime? // 設立日
  status          String    @default("ACTIVE") // ACTIVE/DORMANT/LIQUIDATING
  mainAccountId   String?   // メイン口座ID（口座マスタ参照）
  defaultAssigneeId String? // 経費確認BOXのデフォルト担当
  displayOrder    Int       @default(0) // 表示順
  notes           String?   // 備考
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  accounts        Account[]
  tradingPartners TradingPartner[]
  payrollGroups   PayrollGroup[]
  transactions    Transaction[]
  monthlyBalances MonthlyBalance[]
  loanContracts   LoanContract[]
  leaseContracts  LeaseContract[]
  recurringTemplates RecurringTemplate[]
  monthCloses     MonthClose[]
  reconciliationCheckpoints ReconciliationCheckpoint[]

  @@schema("fina")
  @@map("companies_fina")
}

// ============================================================
// 3. 口座マスタ
// ============================================================

enum AccountType {
  ORDINARY    // 普通預金
  TERM        // 定期預金
  SOCIAL_INSURANCE_RESERVE  // 社会保険積立（仮想口座）
  CONSUMPTION_TAX_RESERVE   // 消費税積立（仮想口座）

  @@schema("fina")
}

model Account {
  id              String      @id @default(cuid())
  companyId       String
  bankName        String?     // 銀行名
  bankCode        String?     // 銀行コード
  branchName      String?     // 支店名
  branchCode      String?     // 支店コード
  accountNumber   String?     // 口座番号
  accountType     AccountType // 口座種別
  accountHolder   String?     // 名義カナ（半角）
  isMain          Boolean     @default(false) // メイン口座フラグ
  isVirtual       Boolean     @default(false) // 仮想口座フラグ
  isActive        Boolean     @default(true)  // 有効フラグ
  isVisible       Boolean     @default(true)  // 表示フラグ
  displayOrder    Int         @default(0)
  // 口座の役割（複数選択可）
  roles           AccountRole[]
  // FB出力設定
  fbSettings      Json?       // {purpose: "general"|"salary"|"bonus", requesterCode, ...}
  // 手数料設定
  feeSettings     Json?       // {sameBranch: {ranges: [{max, fee}]}, otherBranch: ...}
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company         Company     @relation(fields: [companyId], references: [id])
  transactions    Transaction[]
  monthlyBalances MonthlyBalance[]
  // 資金移動先として
  fundTransfersFrom FundTransfer[] @relation("TransferFrom")
  fundTransfersTo   FundTransfer[] @relation("TransferTo")
  reconciliationCheckpoints ReconciliationCheckpoint[]

  @@schema("fina")
  @@map("accounts_fina")
}

// 口座の役割マスタ
model AccountRole {
  id          String  @id @default(cuid())
  accountId   String
  roleKey     String  // "SALARY_PAYMENT", "EXPENSE_PAYMENT", "INCOME_RECEIPT" etc.
  roleName    String  // 表示名
  isActive    Boolean @default(true)

  account     Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, roleKey])
  @@schema("fina")
  @@map("account_roles_fina")
}

// ============================================================
// 4. 月次残高
// ============================================================

model MonthlyBalance {
  id              String  @id @default(cuid())
  companyId       String
  accountId       String
  yearMonth       String  // "YYYY-MM"
  openingBalance  BigInt  @default(0) // 期首残高（円）
  closingBalance  BigInt  @default(0) // 期末残高（円）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id])
  account         Account  @relation(fields: [accountId], references: [id])

  @@unique([accountId, yearMonth])
  @@schema("fina")
  @@map("monthly_balances_fina")
}

// ============================================================
// 5. 勘定科目マスタ（3階層）
// ============================================================

// 大項目（PL区分）
model AccountCategoryMajor {
  id          String  @id @default(cuid())
  name        String  // 売上高, 売上原価, 販売管理費, 営業外収益, 営業外費用, その他費用
  direction   String  // "INCOME" or "EXPENSE"
  displayOrder Int    @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  midCategories AccountCategoryMid[]

  @@schema("fina")
  @@map("account_category_majors_fina")
}

// 中項目（勘定科目）
model AccountCategoryMid {
  id          String  @id @default(cuid())
  majorId     String
  name        String  // 通信費, 地代家賃, 旅費交通費, etc.
  displayOrder Int    @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  major       AccountCategoryMajor @relation(fields: [majorId], references: [id])
  subCategories AccountCategorySub[]
  transactionDetails TransactionDetail[]
  defaultPartnerMappings TradingPartnerDefault[]

  @@schema("fina")
  @@map("account_category_mids_fina")
}

// 小項目（補助科目）
model AccountCategorySub {
  id          String  @id @default(cuid())
  midId       String
  name        String  // 電気代, ガス代, 携帯電話, etc.
  displayOrder Int    @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mid         AccountCategoryMid @relation(fields: [midId], references: [id])
  transactionDetails TransactionDetail[]
  defaultPartnerMappings TradingPartnerDefault[]

  @@schema("fina")
  @@map("account_category_subs_fina")
}

// ============================================================
// 6. 取引先マスタ
// ============================================================

enum TradingPartnerType {
  CUSTOMER   // 請求先
  VENDOR     // 支払先
  BOTH       // 双方

  @@schema("fina")
}

model TradingPartner {
  id              String             @id @default(cuid())
  companyId       String
  name            String
  nameKana        String?
  type            TradingPartnerType
  // タグ（内部キー固定 + 表示名変更可）
  tagKey          String             // "CUSTOMER","SUBCONTRACTOR","EXPENSE","BANK","GROUP_COMPANY","OTHER"
  tagDisplayName  String?            // 管理者が変更可能な表示名
  isActive        Boolean            @default(true)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company         Company            @relation(fields: [companyId], references: [id])
  bankAccounts    TradingPartnerBankAccount[]
  defaults        TradingPartnerDefault[]
  sites           TradingPartnerSite[]
  transactions    Transaction[]

  @@schema("fina")
  @@map("trading_partners_fina")
}

// 取引先の振込先口座（複数登録可）
model TradingPartnerBankAccount {
  id              String  @id @default(cuid())
  partnerId       String
  bankCode        String  // 銀行コード
  branchCode      String  // 支店コード
  accountType     String  // "ORDINARY", "CURRENT"
  accountNumber   String  // 口座番号
  accountHolder   String  // 名義カナ（半角）
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner         TradingPartner @relation(fields: [partnerId], references: [id])

  @@schema("fina")
  @@map("trading_partner_bank_accounts_fina")
}

// 取引先デフォルト科目
model TradingPartnerDefault {
  id          String  @id @default(cuid())
  partnerId   String
  midId       String
  subId       String?

  partner     TradingPartner   @relation(fields: [partnerId], references: [id])
  mid         AccountCategoryMid @relation(fields: [midId], references: [id])
  sub         AccountCategorySub? @relation(fields: [subId], references: [id])

  @@unique([partnerId])
  @@schema("fina")
  @@map("trading_partner_defaults_fina")
}

// 取引先 > 契約/地点テンプレ（任意）
model TradingPartnerSite {
  id              String  @id @default(cuid())
  partnerId       String
  siteName        String  // 地点名（物件名）
  // 定期生成設定
  frequency       String? // "MONTHLY","BIMONTHLY_ODD","BIMONTHLY_EVEN","QUARTERLY","YEARLY","SPECIFIC_MONTHS"
  specificMonths  Int[]   // 特定月指定の場合
  startMonth      Int?    // 開始月
  dueDayRule      String? // "MONTH_END", "DAY_15" etc.
  holidayAdjust   String? // "PREV_BUSINESS","NEXT_BUSINESS","NONE"
  amountType      String? // "FIXED","VARIABLE","MANUAL"
  fixedAmount     BigInt? // 固定金額
  assigneeId      String? // 担当者ID
  midId           String? // デフォルト中項目
  subId           String? // デフォルト小項目
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner         TradingPartner @relation(fields: [partnerId], references: [id])

  @@schema("fina")
  @@map("trading_partner_sites_fina")
}

// ============================================================
// 7. 取引データ（親子構造）
// ============================================================

enum TransactionType {
  EXPENSE        // 経費
  SALES          // 売上
  COST_PAYMENT   // 原価支払
  SALARY         // 給与
  LOAN           // 借入
  TRANSFER       // 振替（内部資金移動・積立等）

  @@schema("fina")
}

enum TransactionStatus {
  DRAFT          // 下書き
  READY          // 準備完了
  CONFIRMED      // 確定済
  CANCELLED      // 取消済

  @@schema("fina")
}

enum PaymentMethod {
  BANK_TRANSFER  // 振込
  DIRECT_DEBIT   // 引落
  CASH_WITHDRAWAL // 現金引出

  @@schema("fina")
}

model Transaction {
  id              String            @id @default(cuid())
  companyId       String
  accountId       String            // 対象口座
  partnerId       String?           // 取引先
  type            TransactionType
  status          TransactionStatus @default(DRAFT)

  // 日付
  transactionDate DateTime?         // 実出納日（実際の入出金日）
  scheduledDate   DateTime?         // 予定日
  accountingMonth String            // 計上月 "YYYY-MM"

  // 金額（親の合計は子明細から自動算出）
  amount          BigInt            @default(0) // 入金は正、支出は負
  estimatedAmount BigInt?           // 予定金額
  actualAmount    BigInt?           // 実績金額

  // 属性
  paymentMethod   PaymentMethod?
  classification  String?           // "FIXED","VARIABLE","TEMPORARY" (固定/変動/臨時)
  summary         String?           // 摘要
  displayOrder    Int               @default(0) // 資金繰り表内の表示順

  // 確定関連
  confirmedAt     DateTime?
  confirmedBy     String?
  readyAt         DateTime?
  readyBy         String?

  // 売上固有
  invoiceDate     DateTime?         // 請求締め日
  invoiceAmount   BigInt?           // 請求金額

  // 原価固有
  recordedAmount  BigInt?           // 計上額（控除前）
  transferAmount  BigInt?           // 振込額（実支払）

  // リンク（会社間取引・資金移動の双方向参照）
  linkedTransactionId String?       // 相手取引ID
  parentId        String?           // 親取引ID（子明細の場合）
  cashWithdrawalBatchId String?     // 現金引出バッチID

  // 証憑
  hasEvidence     Boolean           @default(false)
  evidenceNotRequired Boolean       @default(false) // 証憑なしOK（管理者のみ付与可）

  // 受領
  receivedDate    DateTime?         // 受領日（証憑添付時に自動セット、手修正可）

  // 仮取引先
  temporaryVendorName String?       // 仮取引先名（partnerId 未設定時に使用）

  // 繰り返しテンプレートとの紐付け
  recurringTemplateId String?       // 繰り返しテンプレートID

  // 例外フラグ
  isDateException Boolean           @default(false) // 入力者が実行予定日を手変更した場合 true

  // メタ
  amountUpdatedAt DateTime?         // 金額変更日時
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  company         Company           @relation(fields: [companyId], references: [id])
  account         Account           @relation(fields: [accountId], references: [id])
  partner         TradingPartner?   @relation(fields: [partnerId], references: [id])
  parent          Transaction?      @relation("TransactionChildren", fields: [parentId], references: [id])
  children        Transaction[]     @relation("TransactionChildren")
  details         TransactionDetail[]
  evidences       Evidence[]
  temporaryBankAccount TemporaryBankAccount?
  cashWithdrawal  CashWithdrawalBatch? @relation("BatchTransactions", fields: [cashWithdrawalBatchId], references: [id])
  fundTransfer    FundTransfer?
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])

  @@index([companyId, accountId, accountingMonth])
  @@index([recurringTemplateId])
  @@index([companyId, type, accountingMonth])
  @@index([parentId])
  @@schema("fina")
  @@map("transactions_fina")
}

// 取引明細（子）
model TransactionDetail {
  id              String  @id @default(cuid())
  transactionId   String
  midId           String? // 中項目（勘定科目）
  subId           String? // 小項目（補助科目）
  amount          BigInt  @default(0)
  classification  String? // "FIXED","VARIABLE","TEMPORARY"
  summary         String? // 摘要
  // 控除カテゴリ（売上・原価の控除明細用）
  deductionCategoryId String? // 控除カテゴリマスタ参照
  deductionSubType    String? // 発生/相殺 等
  signMultiplier  Int     @default(1) // 1 or -1（符号自動決定用）
  displayOrder    Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transaction     Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  mid             AccountCategoryMid? @relation(fields: [midId], references: [id])
  sub             AccountCategorySub? @relation(fields: [subId], references: [id])

  @@index([transactionId])
  @@schema("fina")
  @@map("transaction_details_fina")
}

// ============================================================
// 8. 証憑管理
// ============================================================

model Evidence {
  id              String  @id @default(cuid())
  transactionId   String
  fileName        String
  fileUrl         String  // Storage path
  fileSize        Int?
  mimeType        String?
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  // T-11: メタ情報（手入力 or OCR）
  metaTransactionDate DateTime? // 証憑上の取引日
  metaVendorName      String?   // 証憑上の取引先名
  metaAmount          BigInt?   // 証憑上の金額

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("evidences_fina")
}

// ============================================================
// 9. 給与グループマスタ
// ============================================================

model PayrollGroup {
  id              String  @id @default(cuid())
  companyId       String
  name            String  // 区分名（例：工事部門、営業部門）
  costType        String  // "COST"（原価）or "SGA"（販管費）or "OUTSOURCE"（外注）
  midId           String? // 紐づく中項目
  // 支給日設定
  payDay          Int?    // 支給日（25, 27等）
  payDayIsMonthEnd Boolean @default(false) // 月末フラグ
  holidayAdjust   String? // "PREV_BUSINESS","NEXT_BUSINESS"
  // デフォルト口座
  defaultAccountId String? // デフォルト振込口座
  defaultCashAccountId String? // デフォルト現金引出口座
  // 控除セット
  deductionPresets Json?   // [{name, midId, subId}]
  headcount       Int     @default(0) // 人数
  isActive        Boolean @default(true)
  displayOrder    Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id])
  salaryEntries   SalaryEntry[]

  @@schema("fina")
  @@map("payroll_groups_fina")
}

// ============================================================
// 10. 給与入力データ
// ============================================================

model SalaryEntry {
  id              String  @id @default(cuid())
  payrollGroupId  String
  payMonth        String  // 支給月 "YYYY-MM"
  payDate         DateTime? // 支給日

  // 支給項目
  taxablePayment  BigInt  @default(0) // 課税支給
  transportAllowance BigInt @default(0) // 交通費
  miscExpenses    BigInt  @default(0) // 諸経費
  carryoverAdjust BigInt  @default(0) // 繰越金調整
  advanceExpenses BigInt  @default(0) // 立替経費
  totalPayment    BigInt  @default(0) // 総支給（自動計算）

  // 自動積立計算
  socialInsuranceReserve BigInt @default(0) // 社保積立（課税支給×15%）
  consumptionTaxReserve  BigInt @default(0) // 消費税積立（課税支給×10%）

  // 控除合計・差引支給
  totalDeduction  BigInt  @default(0) // 控除合計
  netPayment      BigInt  @default(0) // 差引支給（総支給-控除合計）

  headcount       Int     @default(0) // 人数

  status          TransactionStatus @default(DRAFT)
  confirmedAt     DateTime?
  confirmedBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payrollGroup    PayrollGroup @relation(fields: [payrollGroupId], references: [id])
  deductions      SalaryDeduction[]
  paymentDetails  SalaryPaymentDetail[]

  @@unique([payrollGroupId, payMonth])
  @@schema("fina")
  @@map("salary_entries_fina")
}

// 給与控除明細
model SalaryDeduction {
  id              String  @id @default(cuid())
  salaryEntryId   String
  itemName        String  // 控除項目名（家賃控除、貸金控除、etc.）
  amount          BigInt  @default(0)
  midId           String? // 紐づく中項目
  subId           String? // 紐づく小項目
  contentRows     Json?   // 内容行（複数行）[{description, amount}]
  displayOrder    Int     @default(0)

  salaryEntry     SalaryEntry @relation(fields: [salaryEntryId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("salary_deductions_fina")
}

// 給与 支払内訳（出金イベント）
model SalaryPaymentDetail {
  id              String  @id @default(cuid())
  salaryEntryId   String
  paymentDate     DateTime // 出金日（実出納日）
  paymentMethod   PaymentMethod
  accountId       String?  // 出金口座
  amount          BigInt   @default(0)
  displayOrder    Int      @default(0)

  salaryEntry     SalaryEntry @relation(fields: [salaryEntryId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("salary_payment_details_fina")
}

// ============================================================
// 11. 控除カテゴリマスタ（売上用・原価用で分離）
// ============================================================

model DeductionCategory {
  id              String  @id @default(cuid())
  forType         String  // "SALES" or "COST"
  name            String  // カテゴリ名
  midId           String  // デフォルト中項目
  subId           String? // デフォルト小項目
  hasSubTypes     Boolean @default(false) // 発生/相殺の小項目を持つか
  signRule        Json?   // 符号ルール {occurrence: 1, offset: -1}
  isActive        Boolean @default(true)
  displayOrder    Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("fina")
  @@map("deduction_categories_fina")
}

// ============================================================
// 12. 資金移動
// ============================================================

model FundTransfer {
  id              String  @id @default(cuid())
  transactionId   String  @unique // 紐づく取引
  fromAccountId   String  // 移動元口座
  toAccountId     String  // 移動先口座
  transferDate    DateTime // 移動日
  amount          BigInt  // 金額
  // 会社間資金移動の場合
  counterCompanyId    String? // 相手会社ID
  counterTransactionId String? // 相手側の取引ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transaction     Transaction @relation(fields: [transactionId], references: [id])
  fromAccount     Account     @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount       Account     @relation("TransferTo", fields: [toAccountId], references: [id])

  @@schema("fina")
  @@map("fund_transfers_fina")
}

// ============================================================
// 13. 現金引出バッチ
// ============================================================

model CashWithdrawalBatch {
  id              String  @id @default(cuid())
  companyId       String
  accountId       String  // 引出口座
  withdrawalDate  DateTime // 引出日
  totalAmount     BigInt  // 引出金額

  status          TransactionStatus @default(DRAFT)
  confirmedAt     DateTime?
  confirmedBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 用途明細（リンク先取引）
  linkedTransactions Transaction[] @relation("BatchTransactions")
  // 金種表
  denominations   CashDenomination[]

  @@schema("fina")
  @@map("cash_withdrawal_batches_fina")
}

// 金種表
model CashDenomination {
  id              String  @id @default(cuid())
  batchId         String
  // 各金種の枚数
  yen10000        Int     @default(0)
  yen5000         Int     @default(0)
  yen2000         Int     @default(0)
  yen1000         Int     @default(0)
  yen500          Int     @default(0)
  yen100          Int     @default(0)
  yen50           Int     @default(0)
  yen10           Int     @default(0)
  yen5            Int     @default(0)
  yen1            Int     @default(0)
  total           BigInt  @default(0) // 合計金額
  // 用途明細ごとに持てる
  purposeLabel    String? // 用途ラベル

  batch           CashWithdrawalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("cash_denominations_fina")
}

// ============================================================
// 14. 定期支払テンプレート
// ============================================================

model RecurringTemplate {
  id              String  @id @default(cuid())
  companyId       String
  name            String  // テンプレート名
  // 生成設定
  frequency       String  // "MONTHLY","BIMONTHLY_ODD","BIMONTHLY_EVEN","QUARTERLY","YEARLY","SPECIFIC_MONTHS"
  specificMonths  Int[]   // 特定月指定の場合
  startMonth      Int?    // 任意開始月
  dueDayRule      String  // "MONTH_END","DAY_15","DAY_25" etc.
  holidayAdjust   String  @default("PREV_BUSINESS") // "PREV_BUSINESS","NEXT_BUSINESS","NONE"

  // テンプレート内容
  transactionType TransactionType
  accountId       String?
  partnerId       String?
  midId           String?
  subId           String?
  amountType      String  // "FIXED","VARIABLE","MANUAL"
  fixedAmount     BigInt? // 固定金額
  paymentMethod   PaymentMethod?
  classification  String? // "FIXED","VARIABLE"
  accountingMonthOffset Int @default(0) // 0=当月, -1=前月, 1=翌月
  summary         String?
  assigneeId      String? // 担当者ID

  isActive        Boolean @default(true)
  lastGeneratedMonth String? // 最後に生成した月 "YYYY-MM"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  transactions    Transaction[]

  @@schema("fina")
  @@map("recurring_templates_fina")
}

// ============================================================
// 15. 借入管理
// ============================================================

model LoanContract {
  id              String  @id @default(cuid())
  companyId       String
  partnerId       String? // 借入先（取引先マスタ）
  contractName    String
  principalAmount BigInt  // 借入金額
  executionDate   DateTime // 実行日
  repaymentStartDate DateTime // 返済開始日
  // 返済条件
  repaymentMethod String  // "EQUAL_PRINCIPAL","GRACE","BULLET","QUARTERLY","SEMIANNUAL","BOND"
  repaymentFrequency String // "MONTHLY","QUARTERLY","SEMIANNUAL","ANNUAL"
  repaymentDay    Int?    // 返済日（25,27等）
  holidayAdjust   String  @default("PREV_BUSINESS")
  totalPayments   Int?    // 返済回数
  completionDate  DateTime? // 完済予定日
  // 金利
  interestType    String  // "FIXED","VARIABLE"
  interestRate    Decimal // 金利（%）
  interestTiming  String  @default("ARREAR") // "ADVANCE","ARREAR"（前払/後払）
  dayCountBasis   Int     @default(365) // 日割基準（365/360）
  roundingRule    String  @default("ROUND_HALF_UP") // 端数処理
  principalAdjust String  @default("LAST") // 端数調整 "FIRST","LAST"
  // 金利変更履歴
  interestHistory Json?   // [{effectiveDate, rate}]
  remainingBalance BigInt @default(0) // 残高
  status          String  @default("ACTIVE") // "ACTIVE","COMPLETED","CANCELLED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  schedules       LoanSchedule[]

  @@schema("fina")
  @@map("loan_contracts_fina")
}

// 返済スケジュール
model LoanSchedule {
  id              String  @id @default(cuid())
  contractId      String
  paymentNumber   Int     // 回数
  dueDate         DateTime // 返済日
  principalAmount BigInt  // 元金
  interestAmount  BigInt  // 利息
  totalAmount     BigInt  // 合計
  remainingBalance BigInt // 残高
  isPaid          Boolean @default(false)
  transactionId   String? // 紐づく取引ID

  contract        LoanContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@schema("fina")
  @@map("loan_schedules_fina")
}

// ============================================================
// 16. リース管理
// ============================================================

model LeaseContract {
  id              String  @id @default(cuid())
  companyId       String
  partnerId       String?
  contractName    String
  monthlyAmount   BigInt  // 月額
  startDate       DateTime
  endDate         DateTime?
  totalPayments   Int?    // 回数
  paymentDay      Int?    // 支払日
  holidayAdjust   String  @default("PREV_BUSINESS")
  principalAdjust String  @default("LAST") // 端数調整
  accountId       String? // 支払口座
  midId           String? // 中項目
  subId           String? // 小項目
  status          String  @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  schedules       LeaseSchedule[]

  @@schema("fina")
  @@map("lease_contracts_fina")
}

model LeaseSchedule {
  id              String  @id @default(cuid())
  contractId      String
  paymentNumber   Int
  dueDate         DateTime
  amount          BigInt
  isPaid          Boolean @default(false)
  transactionId   String?

  contract        LeaseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@schema("fina")
  @@map("lease_schedules_fina")
}

// ============================================================
// 17. 月締め管理
// ============================================================

model MonthClose {
  id              String  @id @default(cuid())
  companyId       String
  yearMonth       String  // "YYYY-MM"
  isClosed        Boolean @default(false)
  closedAt        DateTime?
  closedBy        String?
  reopenedAt      DateTime?
  reopenedBy      String?
  reopenReason    String? // 解除理由（必須）

  company         Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, yearMonth])
  @@schema("fina")
  @@map("month_closes_fina")
}

// ============================================================
// 18. 振込バッチ（FB出力用）
// ============================================================

model TransferBatch {
  id              String  @id @default(cuid())
  companyId       String
  accountId       String  // 出金口座
  batchDate       DateTime
  purpose         String  // "GENERAL","SALARY","BONUS"
  status          String  @default("DRAFT") // "DRAFT","CONFIRMED","FB_EXPORTED","TRANSFERRED"
  fbExportedAt    DateTime?
  confirmedAt     DateTime?
  confirmedBy     String?
  totalAmount     BigInt  @default(0)
  totalFee        BigInt  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           TransferBatchItem[]

  @@schema("fina")
  @@map("transfer_batches_fina")
}

model TransferBatchItem {
  id              String  @id @default(cuid())
  batchId         String
  transactionId   String? // 紐づく取引
  recipientName   String  // 受取人名
  bankCode        String
  branchCode      String
  accountType     String
  accountNumber   String
  amount          BigInt
  fee             BigInt  @default(0) // 手数料
  feeOverride     Boolean @default(false) // 手数料手動上書き
  isTransferred   Boolean @default(false) // 振込済フラグ
  displayOrder    Int     @default(0)

  batch           TransferBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("transfer_batch_items_fina")
}

// ============================================================
// 19. 給与自動仕訳マッピング
// ============================================================

model SalaryJournalMapping {
  id              String  @id @default(cuid())
  deductionItemName String // 控除項目名（家賃控除, 通信費控除, etc.）
  majorId         String  // 大項目
  midId           String  // 中項目
  subId           String? // 小項目
  classification  String? // 区分（固定/変動/定期）
  isActive        Boolean @default(true)

  @@unique([deductionItemName])
  @@schema("fina")
  @@map("salary_journal_mappings_fina")
}

// ============================================================
// 20. 仮振込先口座（仮取引先用）
// ============================================================

model TemporaryBankAccount {
  id              String   @id @default(cuid())
  transactionId   String   @unique           // 1取引に1仮口座
  bankCode        String                     // 銀行コード
  bankName        String?                    // 銀行名（表示用）
  branchCode      String                     // 支店コード
  branchName      String?                    // 支店名（表示用）
  accountType     String                     // "ORDINARY","CURRENT"
  accountNumber   String                     // 口座番号
  accountHolder   String                     // 名義カナ（半角）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@schema("fina")
  @@map("temporary_bank_accounts_fina")
}

// ============================================================
// 21. 監査ログ
// ============================================================

model AuditLog {
  id              String  @id @default(cuid())
  tableName       String  // 対象テーブル名
  recordId        String  // 対象レコードID
  operation       String  // "CREATE","UPDATE","DELETE","CONFIRM","UNCONFIRM","MONTH_CLOSE","MONTH_REOPEN"
  userId          String  // 操作ユーザーID
  timestamp       DateTime @default(now())
  beforeData      Json?   // 変更前の値
  afterData       Json?   // 変更後の値
  reason          String? // 変更理由（月締め解除時は必須）

  @@index([tableName, recordId])
  @@index([userId, timestamp])
  @@index([timestamp])
  @@schema("fina")
  @@map("audit_logs_fina")
}

// ============================================================
// 21. 銀行・支店マスタ（初期同梱）
// ============================================================

model BankMaster {
  id          String  @id @default(cuid())
  bankCode    String  @unique
  bankName    String
  bankNameKana String?
  isActive    Boolean @default(true)

  branches    BranchMaster[]

  @@schema("fina")
  @@map("bank_masters_fina")
}

model BranchMaster {
  id          String  @id @default(cuid())
  bankCode    String
  branchCode  String
  branchName  String
  branchNameKana String?
  isActive    Boolean @default(true)

  bank        BankMaster @relation(fields: [bankCode], references: [bankCode])

  @@unique([bankCode, branchCode])
  @@schema("fina")
  @@map("branch_masters_fina")
}

// ============================================================
// 照合チェックポイント（通帳照合点）
// ============================================================
model ReconciliationCheckpoint {
  id              String   @id @default(cuid())
  companyId       String
  accountId       String
  checkpointDate  DateTime
  yearMonth       String   // "YYYY-MM"
  verifiedBalance BigInt
  verifiedBy      String
  verifiedAt      DateTime @default(now())
  note            String?

  company         Company  @relation(fields: [companyId], references: [id])
  account         Account  @relation(fields: [accountId], references: [id])

  @@unique([accountId, yearMonth, checkpointDate])
  @@schema("fina")
  @@map("reconciliation_checkpoints_fina")
}
