# ============================================================
# Database (Supabase PostgreSQL)
# ============================================================

# Transaction pooler (port 6543) - for Prisma runtime queries
# Vercel: production / preview / development
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=fina"

# Session pooler (port 5432) - for Prisma migrations & introspection
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=fina"

# ============================================================
# Supabase API (Storage, Auth)
# ============================================================

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxx"

# ============================================================
# Better Auth
# ============================================================

# Random 32+ char secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="<random-hex-string-32-bytes>"

# Production: https://your-app.vercel.app
# Preview:    automatically set by Vercel (or use VERCEL_URL)
# Local dev:  http://localhost:3003
BETTER_AUTH_URL="http://localhost:3003"

# ============================================================
# Resend (メール送信)
# ============================================================
# 未設定の場合、lib/mail.ts は console.log にフォールバックします (ローカル開発用)
#
# 1. https://resend.com で API キーを発行
# 2. RESEND_API_KEY に貼り付け
# 3. (オプション) 独自ドメインを認証した場合は RESEND_FROM_EMAIL を独自ドメインに変更
#    認証前は "onboarding@resend.dev" でテスト送信可 (送信先は自分のアドレス制限あり)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="経理くん <onboarding@resend.dev>"

# ============================================================
# App URL (申請承認時のパスワード設定リンク等で使う)
# ============================================================
# Local dev:  http://localhost:3003
# Production: https://fina-five.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3003"
